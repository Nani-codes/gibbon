# Production / Coolify image for Gibbon.
# Unlike resources/ops/Dockerfile (local bind-mount), this COPYs the app.

ARG PHP_VERSION=8.3
FROM php:${PHP_VERSION}-apache

RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    curl \
    libicu-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libxml2-dev \
    libcurl4-openssl-dev \
    libonig-dev \
    gettext \
    locales \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i \
              -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' \
              -e 's/# en_GB.UTF-8 UTF-8/en_GB.UTF-8 UTF-8/' \
              -e 's/# es_ES.UTF-8 UTF-8/es_ES.UTF-8 UTF-8/' \
              -e 's/# fr_FR.UTF-8 UTF-8/fr_FR.UTF-8 UTF-8/' \
              -e 's/# zh_TW.UTF-8 UTF-8/zh_TW.UTF-8 UTF-8/' \
              /etc/locale.gen \
    && locale-gen \
    && update-locale LANG=en_GB.UTF-8 LC_ALL=en_GB.UTF-8

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
    mysqli \
    pdo_mysql \
    gd \
    zip \
    intl \
    xml \
    gettext \
    bcmath \
    curl \
    mbstring

RUN a2enmod rewrite setenvif remoteip \
    && sed -i 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf \
    && printf '%s\n' \
        '<Directory /var/www/html>' \
        '    Options FollowSymLinks' \
        '    AllowOverride All' \
        '    Require all granted' \
        '</Directory>' \
        '# Coolify / Traefik terminates TLS; trust forwarded proto for HTTPS checks' \
        'SetEnvIf X-Forwarded-Proto "https" HTTPS=on' \
        >> /etc/apache2/apache2.conf

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY resources/ops/configuration/php/gibbon.ini /usr/local/etc/php/conf.d/gibbon.ini

WORKDIR /var/www/html

COPY --chown=www-data:www-data . /var/www/html

USER www-data
RUN composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction
USER root

COPY resources/ops/scripts/coolify-entrypoint.sh /usr/local/bin/coolify-entrypoint.sh
RUN chmod +x /usr/local/bin/coolify-entrypoint.sh \
    && mkdir -p /var/gibbon-persist \
    && chown -R www-data:www-data /var/www/html /var/gibbon-persist

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/coolify-entrypoint.sh"]
